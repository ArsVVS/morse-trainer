<Window x:Class="MorseTrainer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MorseTrainer.Wpf.Views"
        Title="Азбука Морзе – тренажёр" Width="1100" Height="760" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <TabControl SelectedIndex="{Binding SelectedTab}" Margin="6">
        <TabItem Header="Переводчик">
            <views:TranslatorView DataContext="{Binding Translator}" />
        </TabItem>
        <TabItem Header="Справочник">
            <views:ReferenceView DataContext="{Binding Reference}" />
        </TabItem>
    </TabControl>
</Window>
