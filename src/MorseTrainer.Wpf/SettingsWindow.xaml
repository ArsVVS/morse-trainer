<Window x:Class="MorseTrainer.Wpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MorseTrainer.Wpf"
        Title="Настройки" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <local:EnumNameConverter x:Key="EnumName" />
        <DataTemplate x:Key="EnumItem">
            <TextBlock Text="{Binding Converter={StaticResource EnumName}}" />
        </DataTemplate>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock Text="Изменения применяются сразу" Opacity="0.7" Margin="0,0,0,8" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Margin" Value="0,6" />
                </Style>
            </Grid.Resources>

            <TextBlock Text="Тема" />
            <ComboBox Grid.Column="1" Margin="0,4" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"
                      ItemTemplate="{StaticResource EnumItem}" />

            <TextBlock Grid.Row="1" Text="Алфавит по умолчанию" />
            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4" ItemsSource="{Binding Alphabets}"
                      SelectedItem="{Binding Alphabet}" ItemTemplate="{StaticResource EnumItem}" />

            <TextBlock Grid.Row="2" Text="{Binding Wpm, StringFormat=Скорость: {0} WPM}" />
            <Slider Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1"
                    Minimum="{Binding MinWpm}" Maximum="{Binding MaxWpm}" Value="{Binding Wpm}" />

            <TextBlock Grid.Row="3" Text="{Binding FrequencyHz, StringFormat=Частота тона: {0} Гц}" />
            <Slider Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="10"
                    Minimum="{Binding MinFrequency}" Maximum="{Binding MaxFrequency}" Value="{Binding FrequencyHz}" />

            <TextBlock Grid.Row="4" Text="{Binding Volume, StringFormat=Громкость: {0:P0}}" />
            <Slider Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="0.05"
                    Minimum="0" Maximum="1" Value="{Binding Volume}" />

            <TextBlock Grid.Row="5" Text="Способ вывода" />
            <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,4" ItemsSource="{Binding OutputModes}"
                      SelectedItem="{Binding OutputMode}" ItemTemplate="{StaticResource EnumItem}" />

            <TextBlock Grid.Row="6" Text="{Binding TaskCount, StringFormat=Заданий в сессии: {0}}" />
            <Slider Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1"
                    Minimum="5" Maximum="50" Value="{Binding TaskCount}" />

            <TextBlock Grid.Row="7" Text="Цвет лампы" />
            <ComboBox Grid.Row="7" Grid.Column="1" Margin="0,4" ItemsSource="{Binding LampColors}"
                      SelectedItem="{Binding LampColor}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="16" Height="16" Fill="{Binding}" Stroke="Gray" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding}" Margin="0" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Button Content="Закрыть" HorizontalAlignment="Right" Width="110" Margin="0,16,0,0"
                IsCancel="True" IsDefault="True" Click="OnClose" />
    </StackPanel>
</Window>
