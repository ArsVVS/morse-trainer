<UserControl x:Class="MorseTrainer.Wpf.Views.ReferenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MorseTrainer.Wpf">
    <UserControl.Resources>
        <local:EnumNameConverter x:Key="EnumName" />
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Алфавит:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Width="160" ItemsSource="{Binding Alphabets}" SelectedItem="{Binding Alphabet}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource EnumName}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Щёлкните по строке, чтобы услышать символ" VerticalAlignment="Center"
                       Margin="16,0,0,0" Opacity="0.7" />
        </StackPanel>

        <DataGrid x:Name="Table" Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  HeadersVisibility="Column" MouseLeftButtonUp="OnTableClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Символ" Binding="{Binding Symbol}" Width="100" FontSize="18" />
                <DataGridTextColumn Header="Код" Binding="{Binding PrettyCode}" Width="*" FontSize="20"
                                    FontFamily="Consolas" />
            </DataGrid.Columns>
        </DataGrid>

        <GroupBox Grid.Column="2" Grid.Row="1" Header="Сигнал" VerticalAlignment="Top">
            <StackPanel>
                <Ellipse Width="120" Height="120" Stroke="Gray" StrokeThickness="2" Margin="0,8">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#424242" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLampOn}" Value="True">
                                    <Setter Property="Fill" Value="{Binding Settings.LampColor}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding SelectedRow.Symbol}" FontSize="48" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding SelectedRow.PrettyCode}" FontSize="28" FontFamily="Consolas"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Способ вывода и скорость – в настройках" TextWrapping="Wrap" Opacity="0.7"
                           Margin="0,12,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
