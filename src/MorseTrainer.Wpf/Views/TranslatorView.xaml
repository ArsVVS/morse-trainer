<UserControl x:Class="MorseTrainer.Wpf.Views.TranslatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Поля ввода -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Текст" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="SourceTextBox" Height="90" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" FontSize="16"
                         IsInactiveSelectionHighlightEnabled="True" SelectionBrush="OrangeRed"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Код Морзе" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox Height="90" TextWrapping="Wrap" FontFamily="Consolas" FontSize="18"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Быстрый ввод:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Content="·" Width="44" Margin="0,0,4,0" FontWeight="Bold"
                            Command="{Binding InsertCodeCommand}" CommandParameter="." ToolTip="Точка" />
                    <Button Content="–" Width="44" Margin="0,0,4,0" FontWeight="Bold"
                            Command="{Binding InsertCodeCommand}" CommandParameter="-" ToolTip="Тире" />
                    <Button Content="пробел" Margin="0,0,4,0"
                            Command="{Binding InsertCodeCommand}" CommandParameter=" " ToolTip="Конец буквы" />
                    <Button Content="/" Width="44"
                            Command="{Binding InsertCodeCommand}" CommandParameter=" / " ToolTip="Конец слова" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Предупреждения о неизвестных символах -->
        <TextBlock Grid.Row="1" Text="{Binding Warnings}" Foreground="#E65100" TextWrapping="Wrap" Margin="0,6,0,0" />

        <!-- Скорость и частота -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="70" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Скорость:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Slider Grid.Column="1" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1"
                    Minimum="{Binding Settings.MinWpm}" Maximum="{Binding Settings.MaxWpm}"
                    Value="{Binding Settings.Wpm}" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0"
                       Text="{Binding Settings.Wpm, StringFormat={}{0} WPM}" />
            <TextBlock Grid.Column="3" Text="Частота тона:" VerticalAlignment="Center" Margin="12,0,8,0" />
            <Slider Grid.Column="4" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="10"
                    Minimum="{Binding Settings.MinFrequency}" Maximum="{Binding Settings.MaxFrequency}"
                    Value="{Binding Settings.FrequencyHz}" />
            <TextBlock Grid.Column="5" VerticalAlignment="Center" Margin="8,0"
                       Text="{Binding Settings.FrequencyHz, StringFormat={}{0} Гц}" />
        </Grid>

        <!-- Кнопки воспроизведения -->
        <WrapPanel Grid.Row="3" Margin="0,10,0,0">
            <Button Content="▶ Играть звук" Margin="0,0,6,6" Command="{Binding PlaySoundCommand}" />
            <Button Content="▶ Играть светом" Margin="0,0,6,6" Command="{Binding PlayLightCommand}" />
            <Button Content="▶ Играть вместе" Margin="0,0,6,6" Command="{Binding PlayBothCommand}"
                    ToolTip="Ctrl+Enter" />
            <Button Content="■ Стоп" Margin="0,0,6,6" Command="{Binding StopCommand}" ToolTip="Esc" />
        </WrapPanel>

        <!-- Три варианта вывода -->
        <Grid Grid.Row="4" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Картинка">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Сохранить SVG" Margin="0,0,6,0" Command="{Binding SaveSvgCommand}" />
                        <Button Content="Сохранить PNG" Command="{Binding SavePngCommand}" />
                    </StackPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Image Source="{Binding Image}" Stretch="None"
                               HorizontalAlignment="Left" VerticalAlignment="Top" />
                    </ScrollViewer>
                </DockPanel>
            </GroupBox>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <GroupBox Header="Мерцание">
                    <!-- Viewbox уменьшает лампу, если окно низкое -->
                    <Viewbox MaxWidth="150" MaxHeight="150">
                    <Ellipse Width="150" Height="150" Stroke="Gray" StrokeThickness="2">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#424242" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLampOn}" Value="True">
                                        <Setter Property="Fill" Value="{Binding Settings.LampColor}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    </Viewbox>
                </GroupBox>

                <GroupBox Grid.Row="1" Header="Звук" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding SoundInfo}" TextWrapping="Wrap" />
                        <Button Content="Сохранить WAV" Margin="0,6,0,0" HorizontalAlignment="Left"
                                Command="{Binding SaveWavCommand}" ToolTip="Ctrl+S" />
                    </StackPanel>
                </GroupBox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
