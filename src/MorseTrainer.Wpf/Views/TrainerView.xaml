<UserControl x:Class="MorseTrainer.Wpf.Views.TrainerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MorseTrainer.Wpf">
    <UserControl.Resources>
        <local:EnumNameConverter x:Key="EnumName" />
        <DataTemplate x:Key="EnumItem">
            <TextBlock Text="{Binding Converter={StaticResource EnumName}}" />
        </DataTemplate>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Параметры тренировки -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel IsEnabled="{Binding IsIdle}">
                <TextBlock Text="Режим" Style="{StaticResource Caption}" />
                <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}"
                          ItemTemplate="{StaticResource EnumItem}" />

                <TextBlock Text="Алфавит" Style="{StaticResource Caption}" />
                <ComboBox ItemsSource="{Binding Alphabets}" SelectedItem="{Binding Alphabet}"
                          ItemTemplate="{StaticResource EnumItem}" />

                <TextBlock Style="{StaticResource Caption}" Text="{Binding Level, StringFormat=Уровень: {0}}" />
                <Slider Minimum="1" Maximum="{Binding MaxLevel}" Value="{Binding Level}"
                        IsSnapToTickEnabled="True" TickFrequency="1" />
                <TextBlock Text="{Binding LevelSymbols}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="15" />

                <TextBlock Text="Тип заданий" Style="{StaticResource Caption}" />
                <ComboBox ItemsSource="{Binding TaskKinds}" SelectedItem="{Binding TaskKind}"
                          ItemTemplate="{StaticResource EnumItem}" />

                <TextBlock Text="Вывод сигнала (приём)" Style="{StaticResource Caption}" />
                <ComboBox ItemsSource="{Binding OutputModes}" SelectedItem="{Binding OutputMode}"
                          ItemTemplate="{StaticResource EnumItem}" />

                <TextBlock Text="Ввод ответа (передача)" Style="{StaticResource Caption}" />
                <RadioButton Content="Печатать точки и тире" IsChecked="True" GroupName="Input" />
                <RadioButton Content="Ключ пробелом" IsChecked="{Binding UseKey}" GroupName="Input" />

                <TextBlock Style="{StaticResource Caption}" Text="{Binding Settings.Wpm, StringFormat=Скорость: {0} WPM}" />
                <Slider Minimum="{Binding Settings.MinWpm}" Maximum="{Binding Settings.MaxWpm}"
                        Value="{Binding Settings.Wpm}" IsSnapToTickEnabled="True" TickFrequency="1" />

                <TextBlock Style="{StaticResource Caption}" Text="{Binding Settings.TaskCount, StringFormat=Заданий в сессии: {0}}" />
                <Slider Minimum="5" Maximum="50" Value="{Binding Settings.TaskCount}"
                        IsSnapToTickEnabled="True" TickFrequency="1" />

                <Button Content="Начать" Margin="0,16,0,0" Height="36" Command="{Binding StartCommand}"
                        Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
            </StackPanel>
        </ScrollViewer>

        <!-- Задание -->
        <DockPanel Grid.Column="2">
            <StackPanel DockPanel.Dock="Top">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Прервать" Command="{Binding StopCommand}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding Progress}" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding AccuracyText}" FontSize="16" Margin="24,0,0,0" VerticalAlignment="Center" />
                </DockPanel>
                <ProgressBar Value="{Binding ProgressValue}" Height="6" Margin="0,8,0,0" />
            </StackPanel>

            <!-- Итоги сессии -->
            <GroupBox DockPanel.Dock="Bottom" Header="Итоги сессии" Margin="0,12,0,0"
                      Visibility="{Binding ShowSummary, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding SummaryText}" FontSize="15" />
                    <TextBlock Text="Ошибки:" FontWeight="SemiBold" Margin="0,8,0,4" />
                    <ListBox ItemsSource="{Binding SummaryErrors}" MaxHeight="150" FontFamily="Consolas" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                Visibility="{Binding CanLevelUp, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Точность не ниже 90% – можно перейти на следующий уровень."
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Content="Перейти на следующий уровень" Command="{Binding LevelUpCommand}"
                                Style="{DynamicResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="560">
                <Ellipse Width="90" Height="90" Stroke="Gray" StrokeThickness="2" Margin="0,0,0,12"
                         Visibility="{Binding IsReceive, Converter={StaticResource BoolToVisibility}}">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#424242" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLampOn}" Value="True">
                                    <Setter Property="Fill" Value="{Binding Settings.LampColor}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <TextBlock Text="{Binding Prompt}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,0,0,16" />

                <!-- Ввод с клавиатуры -->
                <TextBox x:Name="AnswerBox" FontSize="22" FontFamily="Consolas"
                         Text="{Binding Answer, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsTypingMode, Converter={StaticResource BoolToVisibility}}" />

                <!-- Ввод ключом -->
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="12"
                        Visibility="{Binding IsKeyMode, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Ellipse DockPanel.Dock="Left" Width="28" Height="28" Margin="0,0,12,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#9E9E9E" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKeyDown}" Value="True">
                                            <Setter Property="Fill" Value="#43A047" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Button DockPanel.Dock="Right" Content="Стереть" Command="{Binding ClearKeyCommand}"
                                Focusable="False" />
                        <TextBlock Text="{Binding LiveCode}" FontSize="24" FontFamily="Consolas"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>
                <TextBlock Text="Держите пробел: короткое нажатие – точка, длинное – тире"
                           Opacity="0.7" Margin="0,4,0,0"
                           Visibility="{Binding IsKeyMode, Converter={StaticResource BoolToVisibility}}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="Ответить (Enter)" Margin="0,0,8,0" IsDefault="True" Focusable="False"
                            Command="{Binding SubmitCommand}" />
                    <Button Content="Повторить (Ctrl+R)" Focusable="False" Command="{Binding RepeatCommand}"
                            Visibility="{Binding IsReceive, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <TextBlock Text="{Binding Feedback}" FontSize="17" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,16,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#E53935" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FeedbackIsCorrect}" Value="True">
                                    <Setter Property="Foreground" Value="#43A047" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
