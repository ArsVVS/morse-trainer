<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>MorseTrainer</AssemblyName>
    <RootNamespace>MorseTrainer.Wpf</RootNamespace>
    <!-- NU1701: SkiaSharp.Views.WPF (зависимость ScottPlot) собран под .NET Framework, но работает.
         WPF0001: тема ThemeMode пока помечена как экспериментальная -->
    <NoWarn>$(NoWarn);NU1701;WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="NAudio" Version="3.1.0" />
    <PackageReference Include="ScottPlot.WPF" Version="5.1.59" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MorseTrainer.Core\MorseTrainer.Core.csproj" />
  </ItemGroup>

</Project>
